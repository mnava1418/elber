{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "Run Back End",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/backEnd"
        },
        {
            "type": "chrome",
            "name": "Debug Front End",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/web"
        }
    ]
}
