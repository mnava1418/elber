NODE_ENV=development
PORT=3000

# Path to the Google service account JSON key (Firebase Admin + Gmail).
# Keep the file out of the repo (it is gitignored as *service-account*.json).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gmail: the service account needs Workspace domain-wide delegation with scope
# https://mail.google.com/ and impersonates this user.
GMAIL_SENDER=no-reply@yourdomain.com
MAIL_FROM_NAME=Elber

# Page the user returns to after changing the password
PASSWORD_RESET_CONTINUE_URL=http://localhost:5173/login
