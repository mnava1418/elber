NODE_ENV=development
PORT=3000

# Path to the Google service account JSON key (Firebase Admin + Gmail).
# Keep the file out of the repo (it is gitignored as *service-account*.json).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gmail: the service account needs Workspace domain-wide delegation with scope
# https://mail.google.com/ and impersonates this user.
GMAIL_SENDER=no-reply@yourdomain.com
MAIL_FROM_NAME=Elber

# Page the user returns to after changing the password
PASSWORD_RESET_CONTINUE_URL=http://localhost:5173/login

# Frontend origins allowed to call the API (CORS), comma separated
CORS_ORIGINS=http://localhost:5173

# Claude API key for the chat agent (https://platform.claude.com)
ANTHROPIC_API_KEY=

# OpenWeather key for the weather skill (One Call 3.0 subscription + Geocoding)
OPENWEATHER_API_KEY=

# Obsidian vault used as Elber's long-term memory (an existing local folder, not in iCloud)
OBSIDIAN_VAULT_PATH=/Users/you/Documents/Cerebro

# Firebase uid of the vault's owner (Firebase console > Authentication > Users > User UID).
# Only this user gets memory.
MEMORY_OWNER_UID=

# Bugs skill: fine-grained GitHub token (github.com > Settings > Developer settings >
# Fine-grained tokens) limited to GITHUB_REPO, with permission Issues: Read and write.
GITHUB_TOKEN=
GITHUB_REPO=mnava1418/elber

# Voice in calls: Amazon Polly with an IAM user whose only permission is
# polly:SynthesizeSpeech. POLLY_VOICE must support the neural engine
# (Mia or Andres for Mexican Spanish).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
POLLY_VOICE=Andres
