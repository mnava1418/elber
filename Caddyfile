# HTTPS in front of the backend. Caddy gets and renews the certificate from
# Let's Encrypt by itself, and proxies Socket.IO's WebSockets as they are.
# The domain comes from ELBER_API_DOMAIN in the root .env; its DNS must point
# at this machine, with ports 80 and 443 open.
{$ELBER_API_DOMAIN} {
	reverse_proxy backend:3000
}
