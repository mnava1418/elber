# Read by docker compose (the host paths it mounts and Caddy's domain). The
# backend's own settings stay in backEnd/.env.

# Obsidian vault Elber uses as its memory, on this machine.
ELBER_VAULT_PATH=/Users/you/Documents/Cerebro

# Domain Caddy serves the backend on, over HTTPS. Its DNS A record must point
# at this machine (ports 80 and 443 open), e.g. api.example.com.
ELBER_API_DOMAIN=api.example.com
