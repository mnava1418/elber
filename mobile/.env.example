# Copy to .env. Everything here ends up inside the app: no secrets.
# Changes need a full reload of the app (not just saving a file).

# Same Firebase web app as web/.env.example.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend API, including the version prefix. localhost only reaches the Mac
# from the iOS simulator. On a physical phone it is the phone itself and on
# the Android emulator it is the emulator: use the Mac's LAN IP
# (e.g. http://192.168.1.20:3000/api/v1) or production
# (https://elber-api.namart.tech/api/v1). The Android emulator can also keep
# localhost after `adb reverse tcp:3000 tcp:3000` (again after each restart).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# true = the chat answers with a canned demo, without the backend
EXPO_PUBLIC_CHAT_MOCK=false
